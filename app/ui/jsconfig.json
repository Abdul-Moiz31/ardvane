{
  "//": "Type-checks the dashboard's JavaScript (JSDoc + // @ts-check) in CI. Nothing is compiled or bundled.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2020",
    "module": "es2020",
    "moduleResolution": "node",
    "lib": ["es2020", "dom", "dom.iterable"],
    "strict": false,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["js/**/*.js"]
}
